{
  "name": "default",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_type": "User",
      "actor_id": 2628905,
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "require_code_owner_review": true,
        "dismiss_stale_reviews_on_push": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "test (Go 1.26, ubuntu-24.04)"
          },
          {
            "context": "test (Go 1.26, ubuntu-24.04-arm)"
          },
          {
            "context": "test (Go 1.27, ubuntu-24.04)"
          },
          {
            "context": "test (Go 1.27, ubuntu-24.04-arm)"
          },
          {
            "context": "test (macOS, fake only)"
          },
          {
            "context": "cross-compile"
          },
          {
            "context": "lint"
          },
          {
            "context": "checks"
          },
          {
            "context": "generated code is fresh"
          },
          {
            "context": "fuzz (FuzzReadMessage)"
          },
          {
            "context": "fuzz (FuzzUnmarshal)"
          },
          {
            "context": "fuzz (FuzzValidateParams)"
          },
          {
            "context": "fuzz (FuzzParse)"
          },
          {
            "context": "bench"
          },
          {
            "context": "gate"
          },
          {
            "context": "systemd v257 (fedora:42)"
          },
          {
            "context": "systemd v258 (fedora:43)"
          }
        ]
      }
    }
  ]
}
