interface io.systemd.Import

# Describes the class of images
type ImageClass(
	# An image to boot as a system on baremetal, in a VM or as a container
	machine,
	# An portable service image
	portable,
	# A system extension image
	sysext,
	# A configuration extension image
	confext
)

# Describes the type of a images to transfer
type RemoteType(
	# Raw binary disk images, typically in a GPT envelope
	raw,
	# A tarball, optionally compressed
	tar
)

# Describes the type of a transfer
type TransferType(
	# A local import of a tarball
	import_tar,
	# A local import of a raw disk image
	import_raw,
	# A local import of a file system tree
	import_fs,
	# A local export of a tarball
	export_tar,
	# A local export of a raw disk image
	export_raw,
	# A download of a tarball
	pull_tar,
	# A download of a raw disk image
	pull_raw
)

# Describes whether and how thoroughly to verify the download before installing it locally
type ImageVerify(
	# No verification
	no,
	# Verify that downloads match checksum file (SHA256SUMS), but do not check signature of checksum file
	checksum,
	# Verify that downloads match checksum file (SHA256SUMS), and check signature of checksum file.
	signature
)

# Structure for log messages associated with a transfer operation
type LogMessage(
	# The log message
	message: string,
	# The priority of the log message, using the BSD syslog priority levels
	priority: int
)

# List ongoing transfers, or query details about specific transfers
# [Requires 'more' flag]
method ListTransfers(
	# Image class to filter by
	class: ?ImageClass
) -> (
	# A unique numeric identifier for the ongoing transfer
	id: int,
	# The type of transfer
	type: TransferType,
	# The remote URL
	remote: string,
	# The local image name
	local: string,
	# The class of the image
	class: ImageClass,
	# Progress in percent
	percent: float
)

# Download a .tar or .raw file. This must be called with the 'more' flag enabled. It will immediately return the numeric ID of the transfer, and then follow up with progress and log message updates, until the transfer is complete.
# [Supports 'more' flag]
method Pull(
	# The remote URL to download from
	remote: string,
	# The local image name to download to
	local: ?string,
	# The type of the resource
	type: RemoteType,
	# The image class
	class: ImageClass,
	# The whether and how thoroughly to verify the download before installing it locally. Defaults to 'signature'.
	verify: ?ImageVerify,
	# If true, an existing image by the local name is deleted. Defaults to false.
	force: ?bool,
	# Whether to make the image read-only after downloading. Defaults ot false.
	readOnly: ?bool,
	# Whether to keep a pristine copy of the download separate from the locally installed image. Defaults to false.
	keepDownload: ?bool,
	# Root directory for images. If not specified derived from the image class, and located below /var/lib/.
	imageRoot: ?string,
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool
) -> (
	# A progress update, as percent value
	progress: ?float,
	# A log message about the ongoing transfer
	log: ?LogMessage,
	# The numeric ID of this download
	id: ?int
)

# A transfer for the specified file is already ongoing
error AlreadyInProgress()

# The transfer has been cancelled on user request
error TransferCancelled()

# The transfer failed
error TransferFailed()

# No currently ongoing transfer
error NoTransfers()
