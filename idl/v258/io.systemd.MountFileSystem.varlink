# APIs for unprivileged mounting.
interface io.systemd.MountFileSystem

# Encodes the designated purpose of a partition.
type PartitionDesignator(
	root,
	usr,
	home,
	srv,
	esp,
	xbootldr,
	swap,
	root_verity,
	usr_verity,
	root_verity_sig,
	usr_verity_sig,
	tmp,
	var
)

# Selects the type of UID/GID mapping to apply.
type MountMapMode(
	# Map the caller's UID to root in the user namespace, do not map anything else.
	root,
	# Map the foreign UID range to the base UID range in the user namespace (i.e. UID zero and above), covering 64K users.
	foreign,
	# Apply an identity (1:1) mapping, but limit it to 64K users.
	identity,
	# Determine automatically based on provided directory and caller.
	auto
)

# Information about a specific partition.
type PartitionInfo(
	# The designator of this partition.
	designator: PartitionDesignator,
	# Indicates whether this partition is marked for writable (non-read-only) operations.
	writable: bool,
	# Indicates whether this partition is marked for automatic growing.
	growFileSystem: bool,
	# Indicates the numeric partition number of this partition, or null if the image does not carry a partition table, and this object covers the whole block device.
	partitionNumber: ?int,
	# Indicates the intended CPU architecture of the partition, in case the partition type encodes such information.
	architecture: ?string,
	# The partition UUID identifying the partition.
	partitionUuid: ?string,
	# The file system type for the mount
	fileSystemType: string,
	# The partition label string of this partition.
	partitionLabel: ?string,
	# The size of the partition in bytes.
	size: int,
	# The start offset of the partition in bytes.
	offset: int,
	# A mount file descriptor to assign to a location.
	mountFileDescriptor: int,
	# A relative path indicating the intended mount point for this file system, if applicable. May contain multiple paths, for certain partitions that can be mounted to multiple distinct places.
	mountPoint: ?[]string
)

# Takes a disk image file descriptor as input, returns a set of mount file descriptors for it, plus meta information about the image and the partitions selected for mounting.
method MountImage(
	# File descriptor of the image file to mount and to assign to the user namespace. Must be a regular, i.e. non-O_PATH file descriptor.
	imageFileDescriptor: int,
	# File descriptor to the user namespace to assign this image to. If not specified uses the host user namespace.
	userNamespaceFileDescriptor: ?int,
	# Mounts the image read-only.
	readOnly: ?bool,
	# Grows the contained file systems if necessary and indicated, before mounting them.
	growFileSystems: ?bool,
	# Takes a literal password in case of an encrypted image
	password: ?string,
	# Takes an image policy string (see systemd.image-policy(7) for details) to apply while mounting the image
	imagePolicy: ?string,
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool
) -> (
	# An array with information about contained partitions that have been prepared for mounting, as well as their mount file descriptors.
	partitions: []PartitionInfo,
	# The used image policy.
	imagePolicy: string,
	# The size of the image in bytes.
	imageSize: int,
	# The sector size of the image in bytes
	sectorSize: int,
	# The name of the image
	imageName: ?string,
	# The UUID of the image
	imageUuid: ?string
)

# Takes a directory file descriptor as input, returns a mount file descriptor.
method MountDirectory(
	# Directory file descriptor of the directory to assign to the user namespace. Must be a regular, i.e. non-O_PATH file descriptor.
	directoryFileDescriptor: int,
	# File descriptor to the user namespace to assign this directory to. If not specified uses the host user namespace.
	userNamespaceFileDescriptor: ?int,
	# Whether to mark the resulting mount file descriptor as read-only. If not specified defaults to false.
	readOnly: ?bool,
	# Which kind of UID/GID mapping to apply to the resulting mount file descriptor.
	mode: ?MountMapMode,
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool
) -> (
	# The freshly allocated mount file descriptor for the mount.
	mountFileDescriptor: int
)

# Creates an empty directory, owned by the foreign UID/GID range's root user, returns an open file descriptor to the directory. Access mode will be set to 0700.
method MakeDirectory(
	# File descriptor of the directory to create the new directory in. Must be a regular, i.e. non-O_PATH file descriptor.
	parentFileDescriptor: int,
	# Name of the directory to create.
	name: string,
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool
) -> (
	# File descriptor referencing the newly created directory.
	directoryFileDescriptor: int
)

# Disk image is not compatible with this service.
error IncompatibleImage()

# Multiple suitable root partitions found.
error MultipleRootPartitionsFound()

# No suitable root partition found.
error RootPartitionNotFound()

# The specified image policy disallows mounting this disk image
error DeniedByImagePolicy()

# The authentication key for this image is not available.
error KeyNotFound()

# Verity could not be set up.
error VerityFailure()
