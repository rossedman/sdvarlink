# Job management interface for the systemd service manager.
interface io.systemd.Job

# Job type
type JobType(
	start,
	verify_active,
	stop,
	reload,
	reload_or_start,
	restart,
	try_restart,
	try_reload,
	nop
)

# Job state
type JobState(
	waiting,
	running,
	finished
)

# Job result
type JobResult(
	done,
	canceled,
	timeout,
	failed,
	dependency,
	skipped,
	invalid,
	assert,
	unsupported,
	collected,
	once,
	frozen,
	concurrency
)

# A job object
type Job(
	# The numeric job ID
	Id: int,
	# The unit name this job operates on
	Unit: ?string,
	# The job type
	JobType: JobType,
	# Current job state. 'finished' indicates the job has completed; in that case Result is also set.
	State: ?JobState,
	# Job result. Only set once the job has reached the 'finished' state.
	Result: ?JobResult,
	# Activation details describing what triggered this job, as key-value pairs
	ActivationDetails: ?[string]string
)

# List queued jobs
# [Supports 'more' flag]
method List(
	# If non-null, filter by job ID
	id: ?int,
	# If non-null, filter by unit name
	unit: ?string
) -> (
	# The numeric job ID
	Id: int,
	# The unit name this job operates on
	Unit: ?string,
	# The job type
	JobType: JobType,
	# Current job state. 'finished' indicates the job has completed; in that case Result is also set.
	State: ?JobState,
	# Job result. Only set once the job has reached the 'finished' state.
	Result: ?JobResult,
	# Activation details describing what triggered this job, as key-value pairs
	ActivationDetails: ?[string]string
)

# Cancel a specific job
method Cancel(
	# The job ID to cancel
	id: int
) -> ()

# Cancel all pending jobs
method ClearAll() -> ()

# The specified job does not exist
error NoSuchJob(
	parameter: ?string
)
