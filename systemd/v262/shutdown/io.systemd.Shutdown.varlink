# APIs for shutting down or rebooting the system.
interface io.systemd.Shutdown

# Power off the system
method PowerOff(
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool,
	# Skip active inhibitors and force the operation
	skipInhibitors: ?bool
) -> ()

# Reboot the system
method Reboot(
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool,
	# Skip active inhibitors and force the operation
	skipInhibitors: ?bool
) -> ()

# Halt the system
method Halt(
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool,
	# Skip active inhibitors and force the operation
	skipInhibitors: ?bool
) -> ()

# Reboot the system via kexec
method KExec(
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool,
	# Skip active inhibitors and force the operation
	skipInhibitors: ?bool
) -> ()

# Reboot userspace only
method SoftReboot(
	# Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.
	allowInteractiveAuthentication: ?bool,
	# Skip active inhibitors and force the operation
	skipInhibitors: ?bool
) -> ()

# Another shutdown or sleep operation is already in progress
error AlreadyInProgress()

# Operation denied due to active block inhibitor
error BlockedByInhibitor(
	# Who is holding the inhibitor
	who: ?string,
	# Why the inhibitor is held
	why: ?string
)
